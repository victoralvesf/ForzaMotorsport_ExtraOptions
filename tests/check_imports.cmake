# cmake -DOBJDUMP=<objdump> -DDLL=<winmm.dll> -P check_imports.cmake
# Fails if the DLL imports anything other than kernel32, user32 or the UCRT api sets.
execute_process(COMMAND "${OBJDUMP}" -p "${DLL}" OUTPUT_VARIABLE dump RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "objdump failed on ${DLL}")
endif()
string(REGEX MATCHALL "DLL Name: [^\r\n]+" names "${dump}")
if(NOT names)
    message(FATAL_ERROR "no imports found in ${DLL}")
endif()
set(bad "")
foreach(line IN LISTS names)
    string(REPLACE "DLL Name: " "" dll "${line}")
    string(TOLOWER "${dll}" dll)
    message(STATUS "import: ${dll}")
    if(NOT dll MATCHES "^(kernel32|user32|api-ms-win-crt-[a-z0-9-]+)\\.dll$")
        list(APPEND bad "${dll}")
    endif()
endforeach()
if(bad)
    message(FATAL_ERROR "winmm.dll imports DLLs outside the system: ${bad}")
endif()
